        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/client": {
      "name": "@scrapline/client",
      "version": "0.0.1"
    },
    "packages/core": {
      "name": "@scrapline/core",
      "version": "0.0.1"
    }
  }
