{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/client" },
    { "path": "./packages/env" }
  ],
  "exclude": ["packages/*/test", "packages/*/tests"]
}
